# AI API Keys (Required for blueprint analysis)
# You need at least one of these (OpenAI is recommended for best results)

# OpenAI API Key (Best performance, paid)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Free, fast, but vision models are currently deprecated)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Google's AI, also has free tier)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./blueprint_reader.db

# Supabase Configuration (Optional - for cloud database and storage)
# Get these from: https://supabase.com/dashboard
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# Clerk Authentication (Required for user auth)
# Get these from: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Environment
ENVIRONMENT=development
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
