@import "tailwindcss";

@theme {
  --font-sans: 'Instrument Sans', sans-serif;
  --font-mono: 'DM Mono', monospace;
  --font-display: 'Syne', sans-serif;
}

:root {
  --bg-base: #080C10;
  --bg-surface: #0E1318;
  --bg-elevated: #141B22;
  --bg-card: #1A232C;
  --border: #1F2D3A;
  --border-bright: #2A3F52;
  --accent: #00D4FF;
  --accent-glow: rgba(0, 212, 255, 0.15);
  --accent-2: #FF6B2B;
  --green: #00E5A0;
  --green-dim: rgba(0, 229, 160, 0.12);
  --text-primary: #E8F0F7;
  --text-secondary: #6B8599;
  --text-muted: #3D5266;
  --font-body: 'Instrument Sans', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg-base);
x
  color: var(--text-primary);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.grid-bg {
  background-image:
    linear-gradient(rgba(0,212,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
}

.glow-accent { box-shadow: 0 0 30px rgba(0,212,255,0.15), 0 0 60px rgba(0,212,255,0.05); }
.glow-text { text-shadow: 0 0 40px rgba(0,212,255,0.4); }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes scan {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100vh); }
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.animate-fade-up   { animation: fadeUp 0.6s ease forwards; }
.animate-fade-up-1 { animation: fadeUp 0.6s 0.1s ease both; }
.animate-fade-up-2 { animation: fadeUp 0.6s 0.2s ease both; }
.animate-fade-up-3 { animation: fadeUp 0.6s 0.3s ease both; }
.animate-fade-up-4 { animation: fadeUp 0.6s 0.4s ease both; }

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg-base); }
::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 3px; }
